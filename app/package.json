{
  "name": "nexivora",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "audit:layout": "node scripts/audit-layout.mjs",
    "bench:import": "node --import ./scripts/test-register.mjs scripts/bench-import.mjs",
    "build": "next build",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run check:contrast && npm run check:chart-palette",
    "check:admin": "node scripts/check-admin.mjs",
    "check:auth": "node scripts/check-auth.mjs",
    "check:chart-palette": "node scripts/check-chart-palette.mjs",
    "check:faculty": "node scripts/check-faculty.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:privacy": "node --import ./scripts/test-register.mjs scripts/check-privacy.mjs",
    "check:project": "node scripts/check-project.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:workspace": "node scripts/check-workspace.mjs",
    "db:deploy": "prisma migrate deploy",
    "db:destroy": "node scripts/db.mjs destroy",
    "db:down": "node scripts/db.mjs down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "node scripts/db-reset.mjs",
    "db:seed": "node --experimental-strip-types prisma/seed/index.ts",
    "db:status": "node scripts/db.mjs status",
    "db:studio": "prisma studio",
    "db:up": "node scripts/db.mjs up",
    "db:verify": "node --import ./scripts/test-register.mjs scripts/verify-db.mjs",
    "dev": "next dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:icons": "node scripts/generate-icons.mjs",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "shot": "node scripts/screenshot.mjs",
    "start": "next start",
    "test": "node --import ./scripts/test-register.mjs --test \"src/**/*.test.ts\"",
    "test:watch": "node --import ./scripts/test-register.mjs --test --watch \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p prisma"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@radix-ui/react-visually-hidden": "^1.2.11",
    "@vercel/blob": "^2.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "17.2.3",
    "next": "16.3.4",
    "nodemailer": "^10.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "mysql2": "^3.24.4",
    "deepmerge-ts": "^8.0.2"
  },
  "description": "Nexivora - The Global Academic Collaboration Network",
  "engines": {
    "node": ">=22"
  }
}
